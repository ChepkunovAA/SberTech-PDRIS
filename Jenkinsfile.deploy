pipeline {
    agent any
        environment {
        NEXUS_URL = "http://nexus:8081"
        NEXUS_CREDENTIALS_ID = "nexus_cred"
        NEXUS_REPOSITORY = "maven-snapshots"
    }


       
    stages {
        stage('Download from Nexus') {
            steps {
                script {
            withCredentials([
                usernamePassword(
                    credentialsId: NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USERNAME',
                    passwordVariable: 'NEXUS_PASSWORD'
                )
            ]) {
                sh """
                    curl -u \${NEXUS_USERNAME}:\${NEXUS_PASSWORD} \
                         -o myapp.jar \
                         \${NEXUS_URL}/repository/\${NEXUS_REPOSITORY}/org/example/myapp/1.0-SNAPSHOT/myapp-1.0-SNAPSHOT.jar
                """
            }
                }
            }
        }

        stage('git clone'){
            steps{
                git branch: 'lab5-deploy', url: 'https://github.com/ChepkunovAA/SberTech-PDRIS'
            }
        }
        
        stage('Run Ansible') {
            steps {
                sh 'ansible-playbook ./ansible/playbook.yml'
            }
        }
    }

}
