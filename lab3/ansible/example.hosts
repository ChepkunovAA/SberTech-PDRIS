[webservers]
nginx_host ansible_host=nginxhost ansible_ssh_user=admin ansible_ssh_pass=securepassword ansible_become_pass=securepassword

[appservers]
python_app_host ansible_host=pythonapp ansible_ssh_user=admin ansible_ssh_pass=securepassword ansible_become_pass=securepassword

[all:vars]
ansible_connection=ssh
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_python_interpreter=/usr/bin/python3